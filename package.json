{
  "name": "brand-os",
  "version": "5.0.0",
  "description": "Multi-tenant marketing workspace built with Next.js and Supabase",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node --import tsx tests/database.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:db && npm run build"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "graphql": "17.0.2",
    "graphql-yoga": "5.24.1",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
