# Copy to .env.local. No secrets are required for the clearly labelled local demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000
# Generate each separately with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Enable only after provider review and sandbox tests. Empty disables live dispatch.
ENABLED_PUBLISH_PROVIDERS=
LINKEDIN_API_VERSION=
META_API_VERSION=

# V4 conversion delivery stays disabled until dataset and consent verification.
ENABLE_CAPI=false
# Pin a supported API version after checking your Meta app.
META_GRAPH_VERSION=

# V5: Google Flow handoff needs no API key. Google API generation is separate.
ENABLE_GOOGLE_VIDEO=false
GOOGLE_VIDEO_API_KEY=
# Pin an available model after a staging contract test; no deprecated Veo preview default.
GOOGLE_VIDEO_MODEL=
